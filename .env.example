[TEMPLATE]
# Copier ce fichier en .env et renseigner les valeurs
DATABASE_URL=sqlite:///backend/db/pharmacie.db
SECRET_KEY=changez-moi
# Chemin du modèle ML (modèle final sorti par le binôme 2)
MODEL_PATH=ml/models/model_final.pkl
# Clé API si l'IA utilise un service externe
API_KEY=
# Identifiants Kaggle (alternatifs à ~/.kaggle/kaggle.json) — entraînement GPU distant
# https://www.kaggle.com/settings/api
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
